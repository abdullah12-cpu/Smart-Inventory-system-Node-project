# Web frontend build configuration.
#
# Leave this file unused for normal browser development: Vite proxies /api to
# http://localhost:5001 (see vite.config.js), so relative API paths just work.
#
# It is REQUIRED for the native (Capacitor) build. The packaged app is served from
# https://localhost inside the WebView with no proxy in front of it, so relative /api paths
# resolve against the WebView itself and every request fails. Point this at the publicly
# reachable backend and src/lib/apiBase.js rewrites all /api calls to it.
#
# Create apps/web/.env.production with a real value before running `npm run build:mobile`:
VITE_API_BASE_URL=https://api.yourdomain.com

# The backend must be reachable over HTTPS from a phone on mobile data -- localhost and LAN
# IPs are not. For testing, an ngrok tunnel to port 5001 works:
#   VITE_API_BASE_URL=https://<your-tunnel>.ngrok-free.dev
